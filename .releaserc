branches:
  - name: main
plugins:
  - - '@semantic-release/commit-analyzer'
    - releaseRules:
        - { release: patch }
      parserOpts:
        noteKeywords:
          - MAJOR RELEASE
  - '@semantic-release/release-notes-generator'
  - - '@semantic-release/github'
      # From: https://github.com/semantic-release/github/pull/487#issuecomment-1486298997
    - successComment: false
      failTitle: false
      draftRelease: true
